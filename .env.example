APP_ENV=development
SECRET_KEY=replace-this-in-production
DATABASE_URL=sqlite:///instance/quant_platform.db
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
REDIS_REQUIRED=false
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
WEB_HOST=127.0.0.1
WEB_PORT=5000
SCHEDULER_ENABLED=true
SCHEDULER_IN_WEB=false
SCHEDULER_TIMEZONE=Asia/Taipei
TW_DATA_SCHEDULE=13:50
US_DATA_SCHEDULE=06:30
FINMIND_BASE_URL=https://api.finmindtrade.com/api/v4/data
FINMIND_TOKEN=
PIT_AUTO_INGESTION_ENABLED=false
PIT_DEFAULT_ENTITIES=tw_futures_daily:TX,tw_options_daily:TXO
PIT_LOOKBACK_DAYS=7
# Daily-workflow modules paused by REQUIREMENTS §13. Unset = all seven below;
# "none" resumes everything; or list a subset.
# PAUSED_MODULES=point_in_time,intraday_features,earnings_calls,model_governance,shadow_trading,promotions,rag_index
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
REPORT_EMAIL_TO=
SMTP_STARTTLS=true
# LINE notifications (Messaging API push; LINE Notify ended 2025-03-31). See docs/line-notifications.md.
LINE_ENABLED=false
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=
# LINE_DAILY_SUMMARY=false   # only invest days and failures, no "no action today" message
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback
GOOGLE_ALLOWED_DOMAIN=
AUTH_SESSION_DAYS=14
AUTH_COOKIE_SECURE=false
API_WRITE_TOKEN=
# Cloudflare Access (published site). The tunnel starts only when AUTH_MODE=cloudflare-access.
AUTH_MODE=development
PUBLIC_URL=https://stockresearch.pimi-sunsun.com
ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
ACCESS_AUD=
ACCESS_ALLOWED_EMAILS=
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_RESPONSE_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_ENABLED=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1024
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=45
# AI researcher (S4-W04): uses OPENAI_API_KEY (or OPENAI_KEY_ENV_FILE=<dotenv with OPENAI_API_KEY>).
# RESEARCH_AGENT_ENABLED=true
# RESEARCH_AGENT_MODEL=gpt-6-luna
# RESEARCH_AGENT_MONTHLY_BUDGET_USD=3
# RESEARCH_AGENT_ROUNDS_PER_NIGHT=3
# RESEARCH_AGENT_SPECS_PER_ROUND=4
# RESEARCH_AGENT_TRIALS_PER_NIGHT=12
# RESEARCH_AGENT_HOUR=22   # 19-23 or 0-6 only
RAG_LOCAL_DIMENSIONS=384
LOCAL_EMBEDDING_BACKEND=hash
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LOCAL_EMBEDDING_DEVICE=auto
LOCAL_EMBEDDING_BATCH_SIZE=32
LOCAL_EMBEDDING_OFFLINE=true
